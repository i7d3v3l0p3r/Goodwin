{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "paths": {
      "solid-js": ["./node_modules/solid-js"],
      "@solidjs/web": ["./node_modules/@solidjs/web"],
      "@solidjs/web/jsx-runtime": ["./node_modules/@solidjs/web/types/jsx.d.ts"]
    },
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts", "../plugins/*/ui/**/*.tsx"]
}
